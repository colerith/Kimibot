# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Python tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Generic local caches
.cache/

# Runtime databases and SQLite sidecar files
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite3
data/*.sqlite3-wal
data/*.sqlite3-shm
